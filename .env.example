# Desenvolvimento: copie para .env.
# Produção: cole estas variáveis na aba "Environment" do recurso no Dokploy.
# NODE_ENV, HOST, PORT, TRUST_PROXY são fixados pelo docker-compose.yml de produção.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=false

# Pasta das fotos e thumbnails do acervo.
# Produção (Dokploy): pasta da VPS montada no container (padrão /srv/fabrica-museu/photos).
# Desenvolvimento: deixe comentado para usar src/public/photos.
# PHOTOS_HOST_PATH=/srv/fabrica-museu/photos

# Rate limit (true/false)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PAGES_ENABLED=true
RATE_LIMIT_API_ENABLED=true

# Configurações
TZ=America/Sao_Paulo

# Versão exibida no rodapé e na imagem Docker (opcionais)
IMAGE_TAG=latest
# BUILD_DATE=2026-04-30T23:00:00Z
# GIT_COMMIT=abc123def
